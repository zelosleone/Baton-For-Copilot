{
  "name": "claude-code-for-copilot",
  "displayName": "Claude Code: Copilot Provider",
  "description": "Use your own Claude Pro or Max subscription in GitHub Copilot Chat, through the Claude Code CLI on your machine.",
  "version": "0.1.1",
  "type": "module",
  "publisher": "DenizhanDaklr",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/zelosleone/Claude-Code-For-Copilot"
  },
  "homepage": "https://github.com/zelosleone/Claude-Code-For-Copilot#readme",
  "bugs": {
    "url": "https://github.com/zelosleone/Claude-Code-For-Copilot/issues"
  },
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "claude",
    "claude code",
    "anthropic",
    "copilot"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "claude-code",
        "displayName": "Claude Code",
        "managementCommand": "claudeCode.manage"
      }
    ],
    "commands": [
      {
        "command": "claudeCode.manage",
        "title": "Claude Code: Manage"
      },
      {
        "command": "claudeCode.signIn",
        "title": "Claude Code: Sign In"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && node build.mjs",
    "lint": "eslint src",
    "package": "vsce package"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.289",
    "@anthropic-ai/sdk": "0.131.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "20.19.30",
    "@types/vscode": "^1.118.0",
    "@typescript-eslint/eslint-plugin": "8.53.0",
    "@typescript-eslint/parser": "8.53.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.2",
    "typescript": "5.9.3",
    "zod": "4.6.5"
  }
}
